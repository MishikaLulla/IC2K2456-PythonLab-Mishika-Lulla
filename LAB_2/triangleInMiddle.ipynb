   "source": [
    "# triangle in middle\n",
    "n = 9\n",
    "for i in range(n):\n",
    "    for j in range(n):\n",
    "        if 1 <= i <= 4 and abs(j - 4) <= i - 1:\n",
    "            print(\" \", end=\"\")\n",
    "        else:\n",
    "            print(\"*\", end=\"\")\n",
    "    print()"
   ]
