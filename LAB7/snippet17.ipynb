   "source": [
    "def is_palindrome(s):\n",
    "    return s == s[::-1]\n",
    "\n",
    "\n",
    "s = \"madam\"\n",
    "\n",
    "result = is_palindrome(s)\n",
    "\n",
    "print(result)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "688d4231-7d7c-446e-91d5-83c36701d468",
   "metadata": {},
   "source": [
    "time complexity: O(n)\n",
    "space complexity: O(n)\n",
    "\n",
    "justify: slicing creates a reversed copy of the string and comparing the strings takes linear time"
   ]
