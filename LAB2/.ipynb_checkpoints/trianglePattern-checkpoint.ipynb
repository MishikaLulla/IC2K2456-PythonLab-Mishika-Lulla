   "source": [
    "#triangle\n",
    "n = int(input(\"enter number of rows\"))\n",
    "for i in range(1, n + 1):\n",
    "\n",
    "    for j in range(n - i):\n",
    "        print(\" \", end=\"\")\n",
    "\n",
    "    for j in range(2 * i - 1):\n",
    "        print(\"*\", end=\"\")\n",
    "\n",
    "    print()"
